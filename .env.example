# Privy dashboard credentials (https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=prv_your_app_id
PRIVY_APP_SECRET=your_app_secret

# P-256 private key used by the server to sign wallet requests as the delegated
# authorization key. Base64-encoded PKCS8 — NO PEM headers.
# Generate with:
#   openssl ecparam -name prime256v1 -genkey -noout -out /tmp/privy_key.pem \
#     && openssl pkcs8 -topk8 -nocrypt -in /tmp/privy_key.pem -outform DER \
#     | base64 | tr -d '\n'
PRIVY_AUTHORIZATION_KEY=

# Key quorum ID created in the Privy Dashboard (Wallet infrastructure >
# Authorization keys). Used by useSigners().addSigners() to grant the server's
# key quorum access to member wallets (TEE mode). Paste the key quorum ID.
SIGNER_ID=

# Chain on which contributions run — Base Sepolia (testnet), chain id 84532.
RPC_URL=https://sepolia.base.org
CONTRIBUTION_CHAIN=base_sepolia
CONTRIBUTION_CHAIN_ID=84532

# The test ERC-20 the job moves, and the pot contract it moves them to.
# Token: deploy contracts/TestToken.sol (mintable, 6 decimals) on Base Sepolia.
CONTRIBUTION_TOKEN_ADDRESS=
POT_RECIPIENT_ADDRESS=

# Weekly amount in token units. The committed policy caps any delegated
# transfer at this value (source.amount <= CONTRIBUTION_AMOUNT).
# Decision: $10-equivalent weekly, 6-decimal token -> "10.0" = 10 * 10^6 units.
CONTRIBUTION_AMOUNT=10.0

# How long a delegation lives. Committed into the policy as a
# system.current_unix_timestamp <= expiry condition at grant time.
CONTRIBUTION_EXPIRY_DAYS=90

# Shared secret that must be sent as `Authorization: Bearer <secret>` to
# POST /api/cron/weekly-contribution.
CRON_SECRET=change-me

# Local SQLite database path. Defaults to <project>/data/devcon-ps3.db.
# Set to a real path if you run the weekly job via the script.
DATABASE_PATH=

# Optional — 0x-hex EVM private key (funded with testnet ETH) used to deploy
# and mint TestToken. Only used by scripts/deploy-token.ts and
# scripts/mint-token.ts.
DEPLOYER_KEY=